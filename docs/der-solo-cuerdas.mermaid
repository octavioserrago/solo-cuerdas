erDiagram
    PROFILES ||--o{ IDENTITY_VERIFICATIONS : requests
    PROFILES ||--o{ SUBSCRIPTIONS : subscribes
    PLANS ||--o{ SUBSCRIPTIONS : defines
    PROFILES ||--o{ LISTINGS : publishes
    CATEGORIES ||--o{ LISTINGS : classifies
    BRANDS |o--o{ LISTINGS : manufactures
    LISTINGS ||--o{ LISTING_MEDIA : contains
    LISTINGS ||--o{ CONVERSATIONS : originates
    PROFILES ||--o{ CONVERSATIONS : starts
    CONVERSATIONS ||--o{ MESSAGES : contains
    PROFILES ||--o{ MESSAGES : sends
    LISTINGS ||--o{ SALES : "is sold in"
    PROFILES ||--o{ SALES : buys
    SALES ||--o{ REVIEWS : enables
    PROFILES ||--o{ REVIEWS : receives
    PROFILES ||--o{ REPORTS : files
    LISTINGS |o--o{ REPORTS : "is reported in"

    PROFILES {
        uuid id PK "= auth.users.id (Supabase)"
        text first_name
        text last_name
        text username
        text phone
        text province
        text city
        enum role "user | moderator | admin"
        enum identity_status "unverified | pending | verified | rejected"
        numeric rating_average "calculated"
        int rating_count "calculated"
        timestamptz created_at
    }
    IDENTITY_VERIFICATIONS {
        uuid id PK
        uuid profile_id FK
        enum method "manual | external_provider"
        text provider "nullable"
        text external_reference "nullable: provider id"
        text document_front_url "nullable, private storage"
        text document_back_url "nullable, private storage"
        text selfie_url "nullable, private storage"
        enum status "pending | approved | rejected"
        uuid reviewed_by FK "nullable: moderator"
        text rejection_reason
        timestamptz created_at
        timestamptz reviewed_at
    }
    PLANS {
        int id PK
        text code "free | plus | store"
        text name "Gratis | Plus | Tienda"
        int max_active_listings
        numeric monthly_price
        int featured_included
    }
    SUBSCRIPTIONS {
        uuid id PK
        uuid profile_id FK
        int plan_id FK
        enum status "active | expired | cancelled"
        timestamptz starts_at
        timestamptz ends_at
    }
    CATEGORIES {
        int id PK
        text name "Guitarra electrica, Violin..."
    }
    BRANDS {
        int id PK
        text name
    }
    LISTINGS {
        uuid id PK
        uuid seller_id FK
        int category_id FK
        int brand_id FK "nullable: luthier or unbranded"
        text model
        text title
        text description
        int manufacture_year
        text origin
        text serial_number
        enum item_condition "new | excellent | very_good | good | needs_repair"
        numeric price
        enum currency "ARS | USD"
        text province
        text city
        enum status "draft | active | paused | sold | deleted"
        timestamptz featured_until
        timestamptz created_at
    }
    LISTING_MEDIA {
        uuid id PK
        uuid listing_id FK
        enum media_type "photo | audio | video"
        text url
        int sort_order
        text perceptual_hash "duplicate detection"
        bool is_verification_photo "sign with username and date"
    }
    CONVERSATIONS {
        uuid id PK
        uuid listing_id FK
        uuid buyer_id FK
        timestamptz created_at
    }
    MESSAGES {
        uuid id PK
        uuid conversation_id FK
        uuid sender_id FK
        text content
        bool is_read
        timestamptz sent_at
    }
    SALES {
        uuid id PK
        uuid listing_id FK
        uuid buyer_id FK
        numeric final_price
        enum currency "ARS | USD"
        enum status "pending_confirmation | completed | cancelled"
        timestamptz created_at
        timestamptz completed_at
    }
    REVIEWS {
        uuid id PK
        uuid sale_id FK
        uuid reviewer_id FK
        uuid reviewee_id FK
        int rating "1 to 5"
        text comment
        timestamptz created_at
    }
    REPORTS {
        uuid id PK
        uuid reporter_id FK
        uuid listing_id FK "nullable"
        uuid reported_profile_id FK "nullable"
        text reason
        enum status "open | resolved | dismissed"
        uuid resolved_by FK
        timestamptz created_at
    }
